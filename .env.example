# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret (min 64 random chars in production, use: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_random_string

# Your deployed Vercel URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary — find these in your Cloudinary dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# (Bonus) OpenAI — for AI caption/message generation feature
OPENAI_API_KEY=sk-...

# (Bonus) Vercel API token — for programmatic deployments
VERCEL_TOKEN=your_vercel_token
