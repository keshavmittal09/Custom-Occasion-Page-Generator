# ─── Required in production (optional locally) ─────────────────────────────────

# MongoDB connection string (MongoDB Atlas free tier works). If empty in local dev,
# the app starts its own local MongoDB automatically (data kept in .data/mongo).
MONGO_URI=

# Secret used to sign login + page-unlock JWTs. Generate one with: openssl rand -hex 32
# If empty in local dev, a random secret is generated per run (you'll be logged out on restart).
JWT_SECRET=

# Public base URL of the app, no trailing slash (used for share links, OG images and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Media uploads (recommended) ───────────────────────────────────────────────
# Cloudinary credentials for direct, signed browser uploads (images, videos, songs).
# If empty, uploads are stored in MongoDB instead (max 4 MB per file, no large videos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────────
# GIPHY API key to enable GIF search in the wizard (paste-a-link works without it)
GIPHY_API_KEY=

# Set to "false" to stop the app from creating demo accounts/pages on an empty database
SEED_ON_EMPTY=true
